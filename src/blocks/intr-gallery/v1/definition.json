{
  "type": "intr-gallery",
  "version": 1,
  "label": "Intr · Project gallery",
  "description": "Static image grid with optional captions, introductory copy and a quotation. Every third image spans the grid.",
  "theme": "Intr",
  "tags": ["intr", "interior", "portfolio"],
  "kind": "static",
  "framework": "react",
  "activation": "never",
  "component": "View.tsx",
  "fields": [
    {
      "key": "heading",
      "label": "Heading",
      "type": "text"
    },
    {
      "key": "description",
      "label": "Description",
      "type": "text",
      "multiline": true
    },
    {
      "key": "quote",
      "label": "Quotation",
      "type": "text",
      "multiline": true
    },
    {
      "key": "images",
      "label": "Images",
      "type": "list",
      "fields": [
        {
          "key": "image",
          "label": "Image",
          "type": "media"
        },
        {
          "key": "caption",
          "label": "Caption",
          "type": "text",
          "multiline": true
        }
      ]
    }
  ],
  "defaults": {
    "heading": "",
    "description": "",
    "quote": "",
    "images": []
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
