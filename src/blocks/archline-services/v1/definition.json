  "version": 1,
  "label": "Archline · Services grid",
  "description": "Dark checkerboard of service descriptions and photographs.",
  "theme": "Archline",
  "tags": ["archline", "architecture", "editorial"],
  "kind": "static",
  "framework": "react",
  "activation": "never",
  "component": "View.tsx",
  "fields": [
    {
      "key": "anchor",
      "label": "Section anchor",
      "type": "text"
