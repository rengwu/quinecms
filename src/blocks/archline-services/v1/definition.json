        {
          "key": "title",
          "label": "Service title",
          "type": "text"
        },
        {
          "key": "description",
          "label": "Description",
          "type": "text",
          "multiline": true
        }
      ]
    },
    {
      "key": "images",
      "label": "Service photographs",
      "type": "list",
