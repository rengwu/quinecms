        "description": "Natural textures chosen to age beautifully and feel good to the touch."
      },
      {
        "_rowId": "row-4",
        "title": "Human Experience",
        "description": "Comfort, movement and belonging at the heart of every decision."
      }
    ],
    "images": [
      {
        "_rowId": "row-1",
        "image": null
      },
      {
        "_rowId": "row-2",
        "image": null
