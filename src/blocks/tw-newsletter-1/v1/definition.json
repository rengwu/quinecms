{
  "type": "tw-newsletter-1",
  "version": 1,
  "label": "Dark signup card",
  "theme": "Tailwind UI",
  "tags": ["newsletter", "form", "signup"],
  "description": "A focused, spacious layout.",
  "kind": "static",
  "placement": "page",
