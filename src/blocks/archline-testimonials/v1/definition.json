{
  "type": "archline-testimonials",
  "version": 1,
  "label": "Archline · Photo testimonials",
  "description": "Manual slideshow with previous, next and pagination controls. No automatic rotation.",
  "theme": "Archline",
  "tags": ["archline", "architecture", "editorial"],
  "kind": "static",
  "framework": "react",
  "activation": "load",
  "component": "View.tsx",
  "fields": [
    {
      "key": "label",
      "label": "Accessible label",
      "type": "text"
    },
    {
      "key": "image",
      "label": "Background image",
      "type": "media"
    },
    {
      "key": "items",
      "label": "Testimonials",
      "type": "list",
      "fields": [
        {
          "key": "quote",
          "label": "Quote",
          "type": "text",
          "multiline": true
        },
        {
          "key": "name",
          "label": "Attribution",
          "type": "text"
        },
        {
          "key": "role",
          "label": "Role or context",
          "type": "text"
        },
        {
          "key": "image",
          "label": "Small image",
          "type": "media"
        }
      ]
    }
  ],
  "defaults": {
    "label": "Client reflections",
    "image": null,
    "items": [
      {
        "_rowId": "row-1",
        "quote": "A space that feels open, personal and beautifully resolved. The smallest details make the everyday experience a pleasure.",
        "name": "A considered home",
        "role": "Illustrative client reflection",
        "image": null
      }
    ]
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
