{
  "type": "tw-logos-2",
  "version": 1,
  "label": "Partner logo grid",
  "theme": "Tailwind UI",
  "tags": ["logos", "partners", "social proof"],
  "description": "An expressive layout with a clear visual balance.",
  "kind": "static",
  "placement": "page",
  "framework": "react",
  "activation": "never",
  "component": "View.tsx",
  "fields": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "type": "text"
    },
    {
      "key": "heading",
      "label": "Heading",
      "type": "text",
      "required": true
    },
    {
      "key": "description",
      "label": "Description",
      "type": "text",
      "multiline": true
    },
    {
      "key": "items",
      "label": "Items",
