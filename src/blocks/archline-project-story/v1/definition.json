{
  "type": "archline-project-story",
  "version": 1,
  "label": "Archline · Project story",
  "description": "A sticky summary and project facts beside a sequence of image-led chapters.",
  "theme": "Archline",
  "tags": ["archline", "architecture", "editorial"],
  "kind": "generic",
  "framework": "react",
  "activation": "never",
  "component": "View.tsx",
  "fields": [
    {
