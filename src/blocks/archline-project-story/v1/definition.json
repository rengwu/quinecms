    {
      "key": "description",
      "label": "Description",
      "type": "text",
      "multiline": true
    },
    {
      "key": "facts",
      "label": "Project facts",
      "type": "list",
      "fields": [
        {
          "key": "label",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "value",
