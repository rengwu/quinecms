{
  "type": "archline-project-index",
  "version": 1,
  "label": "Archline · Project index",
  "description": "Three-column portfolio index using the same shared project entries.",
  "theme": "Archline",
  "tags": ["archline", "architecture", "editorial"],
  "kind": "static",
  "framework": "react",
  "activation": "never",
  "component": "View.tsx",
  "fields": [
    {
      "key": "anchor",
      "label": "Section anchor",
      "type": "text"
    },
    {
      "key": "label",
      "label": "Section label",
      "type": "text"
    },
    {
      "key": "heading",
      "label": "Heading",
      "type": "text"
    },
    {
      "key": "description",
      "label": "Description",
      "type": "text",
      "multiline": true
    },
    {
      "key": "actionLabel",
      "label": "Link label",
      "type": "text"
    },
    {
      "key": "actionURL",
      "label": "Link URL",
      "type": "url"
    },
    {
      "key": "collection",
      "label": "Project collection",
      "type": "collection"
    },
    {
      "key": "titleField",
      "label": "Title field",
      "type": "text",
      "collectionField": {
        "collectionKey": "collection",
        "types": ["text"]
      }
    },
    {
      "key": "summaryField",
      "label": "Year field",
      "type": "text",
      "collectionField": {
        "collectionKey": "collection",
        "types": ["text"]
      }
    },
    {
      "key": "imageField",
      "label": "Cover image field",
      "type": "text",
      "collectionField": {
        "collectionKey": "collection",
        "types": ["media"]
      }
    },
    {
      "key": "projects",
      "label": "Selected projects (empty shows all)",
      "type": "list",
      "fields": [
        {
          "key": "project",
          "label": "Project",
          "type": "reference",
          "collectionId": "collection_archline_projects"
        }
      ]
    }
  ],
  "defaults": {
    "anchor": "",
    "label": "",
    "heading": "Places made for living, and designed to endure.",
    "description": "Explore our portfolio of homes, interiors and spaces for gathering. Each project begins with its own context and finds a distinct architectural expression.",
    "actionLabel": "",
    "actionURL": "",
    "collection": null,
    "titleField": "title",
    "summaryField": "year",
    "imageField": "image",
    "projects": []
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
