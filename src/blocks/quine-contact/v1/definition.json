{
  "type": "quine-contact",
  "version": 1,
  "label": "Quine · Contact",
  "description": "Full-width contact section with editable link and wordmark.",
  "theme": "Quine",
  "tags": ["contact", "image"],
  "framework": "react",
  "activation": "visible",
  "component": "View.tsx",
  "fields": [
    {
      "key": "anchor",
      "label": "Section anchor",
      "type": "text"
    },
    {
      "key": "heading",
      "label": "Heading",
      "type": "text"
    },
    {
      "key": "linkLabel",
      "label": "Contact link text",
      "type": "text"
    },
    {
      "key": "linkURL",
      "label": "Contact URL",
      "type": "url"
    },
    {
      "key": "brand",
      "label": "Wordmark",
      "type": "text"
    },
    {
      "key": "image",
      "label": "Background image",
      "type": "media"
    }
  ],
  "defaults": {
    "anchor": "contact",
    "heading": "Contact us",
    "linkLabel": "hello@quinesystems.com",
    "linkURL": "mailto:hello@quinesystems.com",
    "brand": "Quine Systems",
    "image": null
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
