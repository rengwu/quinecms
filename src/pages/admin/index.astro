---
import { gzipSync } from 'node:zlib';
import { loadContent } from '../../core/load';
import { adminBundle } from '../../../scripts/admin-build';
import { credentials, encryptAdmin } from '../../admin/crypto';
import { storageFromEnv } from '../../admin/storage';
import { gitFromEnv } from '../../admin/git';
import { faviconHref } from '../../editor/brand';
import { loginScreen } from '../../admin/login-screen';
import '../../admin/login-screen.css';
// Each site supplies its own shared credential pair in every environment.
const email = import.meta.env.ADMIN_EMAIL ?? '';
const password = import.meta.env.ADMIN_PASSWORD ?? '';
credentials(email, password);
const initial = await loadContent();
const config = {
  encryptedAdmin: true,
  git: gitFromEnv({
    GIT_PROVIDER: import.meta.env.GIT_PROVIDER,
    GIT_OWNER: import.meta.env.GIT_OWNER,
    GIT_REPO: import.meta.env.GIT_REPO,
    GIT_ACCESS_TOKEN: import.meta.env.GIT_ACCESS_TOKEN,
    GIT_DRAFT_BRANCH: import.meta.env.GIT_DRAFT_BRANCH,
    GIT_PUBLISH_BRANCH: import.meta.env.GIT_PUBLISH_BRANCH,
    GITLAB_URL: import.meta.env.GITLAB_URL,
  }),
  r2: storageFromEnv({
    R2_ACCOUNT_ID: import.meta.env.R2_ACCOUNT_ID,
    R2_BUCKET: import.meta.env.R2_BUCKET,
    R2_PUBLIC_URL: import.meta.env.R2_PUBLIC_URL,
    R2_ACCESS_KEY_ID: import.meta.env.R2_ACCESS_KEY_ID,
    R2_SECRET_ACCESS_KEY: import.meta.env.R2_SECRET_ACCESS_KEY,
    R2_MAX_MB: import.meta.env.R2_MAX_MB,
    R2_IMAGE_WIDTHS: import.meta.env.R2_IMAGE_WIDTHS,
    R2_IMAGE_QUALITY: import.meta.env.R2_IMAGE_QUALITY,
  }),
};
const bundle = await adminBundle(import.meta.env.LEAN_DEV_SERVER);
const payload = gzipSync(
  JSON.stringify({ ...bundle, props: { initial, config } }),
);
const envelope = await encryptAdmin(payload, email, password);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>QuineCMS · Site editor</title>
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
  </head>
  <body>
    <Fragment set:html={loginScreen} />
    <div id="editor-root" hidden></div>
    <script
      id="admin-payload"
      type="application/json"
      set:html={JSON.stringify(envelope)}
    />
    <script>
      import '../../admin/login';
    </script>
    <noscript>The site editor needs JavaScript enabled.</noscript>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }
</style>
