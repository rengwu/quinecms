{
  "id": "quine",
  "version": 1,
  "label": "Quine Systems",
  "description": "Warm neutral canvas, expressive typography and a compact fixed navigation. Pair with the independent Quine blocks.",
  "activation": "load",
  "defaults": {
    "contentMaxWidth": 1440,
    "pageGutter": 32,
    "title": "Quine Systems",
    "description": "A digital design studio creating memorable brand experiences, engineered for maximum impact.",
    "brand": "Quine Systems",
    "homeURL": "/",
    "navigation": [
      {
        "_rowId": "nav-services",
        "label": "Services",
        "url": "#services"
      },
      {
        "_rowId": "nav-works",
        "label": "Works",
        "url": "#works"
      }
    ],
    "actionLabel": "Get in touch",
    "actionURL": "#contact"
  },
  "fields": [
    {
      "key": "title",
      "label": "Site title",
      "type": "text"
    },
    {
      "key": "description",
      "label": "Site description",
      "type": "text",
      "multiline": true
    },
    {
      "key": "brand",
      "label": "Accessible brand name",
      "type": "text"
    },
    {
      "key": "homeURL",
      "label": "Home URL",
      "type": "url"
    },
    {
      "key": "navigation",
      "label": "Header navigation",
      "type": "list",
      "fields": [
        {
          "key": "label",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ]
    },
    {
      "key": "actionLabel",
      "label": "Header action label",
      "type": "text"
    },
    {
      "key": "actionURL",
      "label": "Header action URL",
      "type": "url"
    }
  ],
  "component": "View.tsx",
  "settingsComponent": "Settings.tsx",
  "policy": "policy.ts",
  "headComponent": "Head.tsx"
}
