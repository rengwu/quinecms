---
import type { Content } from '../core/types';
import { layoutTitle } from '../core/layouts';
interface Props {
  content: Content;
  title: string;
}
const { content, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{[title, layoutTitle(content.site)].filter(Boolean).join(' · ')}</title>
    <slot name="head" />
  </head>
  <body data-layout-surface>
    <slot />
  </body>
</html>
