---
import type { Content } from '../core/types';
import SelectedLayout from '../generated/SelectedLayout.astro';
import SelectedHead from '../generated/SelectedHead.astro';
import { layoutTitle } from '../core/layouts';
import '../styles/public.css';
interface Props {
  content: Content;
  title: string;
}
const { content, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{[title, layoutTitle(content.site)].filter(Boolean).join(' · ')}</title>
    <SelectedHead content={content} />
  </head>
  <body data-layout-surface>
    <SelectedLayout content={content}>
      <slot />
    </SelectedLayout>
  </body>
</html>
