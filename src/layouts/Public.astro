---
import type { Content } from '../core/types';
import SiteHeader from '../site/Header';
import Footer from '../generated/Footer.astro';
import { siteStyle } from '../core/site-style';
import '../styles/public.css';
interface Props {
  content: Content;
  title: string;
}
const { content, title } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  data-theme={content.site.globals.theme}
  style={siteStyle(content.site.globals)}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {content.site.title}</title>
  </head>
  <body class="site-surface">
    <SiteHeader content={content} />
    <main>
      <slot />
    </main>
    <Footer content={content} />
  </body>
</html>
