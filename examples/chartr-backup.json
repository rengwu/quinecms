        "slug": "keep-the-essentials",
        "values": {
          "title": "Keep the essentials",
          "summary": "Content that stays yours.",
          "date": "2026-10-06",
          "body": "## A place for your ideas\n\nYour words live in simple files. Your layout lives in a reusable page. Change one without rebuilding the other.\n\nThat separation makes a small site easier to care for.",
          "image": null
        }
      },
      {
        "formatVersion": 1,
        "id": "entry_slow",
        "collectionId": "collection_journal",
        "slug": "a-slower-way-to-build",
        "values": {
          "title": "A slower way to build",
          "summary": "Make room for what matters.",
          "date": "2026-10-06",
          "body": "## Start with a purpose\n\nA small website can be a thoughtful home for your work. Choose what it needs to say, then give those ideas room to breathe.\n\n- Write clearly.\n- Keep the useful parts.\n- Make it easy to return.",
          "image": null
        }
      }
