          "id": "block_intr_story",
          "type": "intr-story",
          "version": 1,
          "props": {
            "heading": "A quiet home in Dubai, where warm materials and careful proportions make room for everyday life.",
            "description": "Maison Dorée brings a restrained palette of stone, timber and soft plaster into a generous residential interior. The aim was a home that feels composed without becoming formal, where each room offers a different way to gather or retreat.\n\nWe developed the layouts, finishes and furniture as one continuous design. Sculptural lighting and crafted details give the spaces character, while natural textures keep them calm and welcoming.",
            "listHeading": "Process",
            "items": [
              {
                "_rowId": "maison-process-1",
                "label": "Pre-Concept"
              },
              {
                "_rowId": "maison-process-2",
                "label": "Concept Design"
              },
              {
                "_rowId": "maison-process-3",
                "label": "Schematic Design"
              },
              {
                "_rowId": "maison-process-4",
                "label": "Detail Design"
              },
              {
                "_rowId": "maison-process-5",
                "label": "Tender Documentation"
              },
              {
                "_rowId": "maison-process-6",
                "label": "Construction Support"
              }
            ],
            "anchor": "project-story"
          }
        },
