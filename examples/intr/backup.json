          "version": 1,
          "props": {
            "anchor": "contact",
            "heading": "Want your interior to feel refined and timeless?",
            "caption": "Where comfort meets timeless elegance.",
            "detail": "Thoughtfully designed interiors",
            "image": {
              "mediaId": "media_intr_contact_3",
