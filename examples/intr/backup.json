      "blocks": [
        {
          "id": "block_intr_hero",
          "type": "intr-hero",
          "version": 1,
          "props": {
            "heading": "intr ® Studio",
            "description": "We create functional and elegant interior spaces tailored to your lifestyle, taste, and budget — from concept to execution.",
            "image": {
              "mediaId": "media_intr_hero_1",
              "alt": "Sculpted timber chair arm beside a textured plaster wall."
            },
            "metadata": [],
            "scrollLabel": "Scroll down",
            "scrollURL": "#about"
          }
        },
        {
          "id": "block_intr_intro",
          "type": "intr-introduction",
          "version": 1,
          "props": {
            "anchor": "about",
            "heading": "Spaces",
            "caption": "that feel like home",
            "description": "We are an interior design studio creating homes with personality and purpose. Through considered materials, thoughtful planning and a close understanding of how you live, we shape spaces that feel beautiful, useful and entirely yours.",
            "actionLabel": "Get Started",
            "actionURL": "#contact",
            "leftImage": {
              "mediaId": "media_intr_about_1",
              "alt": "A timber console and ceramic vase in a sunlit hallway."
            },
            "rightImage": {
              "mediaId": "media_intr_about_2",
              "alt": "Sculptural ceramic vessels on a stone plinth."
            },
            "stats": [
              {
                "_rowId": "intr-stats-1",
                "value": "8+",
                "label": "Years of Experience"
              },
              {
                "_rowId": "intr-stats-2",
                "value": "20+",
                "label": "Design Awards & Features"
              },
              {
                "_rowId": "intr-stats-3",
                "value": "95%",
                "label": "Client Satisfaction"
              }
            ]
          }
        },
        {
          "id": "block_intr_selected",
          "type": "intr-projects",
          "version": 1,
          "props": {
            "anchor": "projects",
            "heading": "(Selected Work)",
            "description": "A collection of interiors shaped by the people who use them. Different places, connected by a considered approach to comfort, proportion and materials.",
            "actionLabel": "See all works",
            "actionURL": "/projects",
            "collection": "collection_intr_projects",
            "titleField": "title",
            "summaryField": "location",
            "imageField": "image",
            "urlField": "url",
