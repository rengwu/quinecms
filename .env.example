# This is a convenience gate, not authorization for private data.
ADMIN_PASSWORD=change-me
PUBLIC_GITHUB_OWNER=
PUBLIC_GITHUB_REPO=
PUBLIC_DRAFT_BRANCH=draft
PUBLIC_R2_ACCOUNT_ID=
PUBLIC_R2_BUCKET=
PUBLIC_R2_PUBLIC_URL=
