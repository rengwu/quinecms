# QuineCMS site environment
# Copy to .env for local use, or set these in the host/CI build environment.
# Keep real credentials out of Git. Restart dev / rebuild and redeploy after changes.

# --- Admin login (required for development and production) ---
# Choose your own email and a long, unique password. No production fallback.
# Email is trimmed/lowercased; password characters and whitespace are preserved.
# Development also uses these site-owned values; the engine has no default login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Repository connection (optional; managed here, never in the admin UI) ---
# Fill all three: owner/group, repository and token. All blank = local preview only.
# Partial settings fail the build. The editor connects automatically after login.
# github or gitlab. Owner is the GitHub account or GitLab group/subgroups.
GIT_PROVIDER=github
GIT_OWNER=
GIT_REPO=
# GitHub: repository Contents read/write. GitLab: api scope and project access.
# Never prefix this with PUBLIC_. The token enters only the encrypted admin payload.
# Anyone with the admin login receives this Git access. Use a token for this site.
# Use a disposable repository/token for development.
GIT_ACCESS_TOKEN=
# Optional defaults; branches must differ. Configure hosting to build the publish branch.
GIT_DRAFT_BRANCH=draft
GIT_PUBLISH_BRANCH=main
# Used only for GitLab; HTTPS URL, optionally including an installation subpath.
# GitLab requires fast-forward merges and optional/disabled squashing.
GITLAB_URL=https://gitlab.com
# Previous PUBLIC_GIT_*, PUBLIC_DRAFT_BRANCH and PUBLIC_PUBLISH_BRANCH are unused.
# Change these build values and redeploy to switch repositories or rotate a token.

# --- Media uploads (optional; managed here, never in the admin UI) ---
# Leave ALL FIVE connection values blank to disable uploads; existing media works.
# To enable uploads, fill all five. Partial/invalid settings fail the build.
# R2 settings/keys enter only the encrypted admin payload, not public plaintext.
# Anyone who unlocks the editor can recover these keys to perform direct uploads.
# Use Object Read & Write credentials scoped to this bucket. Use test keys in dev.
# Account ID: 32 hex characters (or the standard R2 S3 endpoint).
R2_ACCOUNT_ID=
R2_BUCKET=
# HTTPS public bucket/custom-domain URL, not the S3 API endpoint.
R2_PUBLIC_URL=
# The two S3 credentials from a Cloudflare R2 API token, not the API token string.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Upload defaults (used only when uploads are configured) ---
# Maximum original size in MB, greater than zero.
R2_MAX_MB=30
# Comma-separated integer widths, 64–4096px. Empty = originals only; no upscaling.
R2_IMAGE_WIDTHS=480,960,1600
# WebP variant quality, 0.1–1.
R2_IMAGE_QUALITY=0.8

# In Cloudflare bucket Settings, enable a public URL and allow your editor origins
# in CORS (GET, HEAD, PUT, DELETE; headers *; expose ETag). Preserve other origins.
# Setup and CORS example: docs/wiki/features/media.md in the QuineCMS engine repo.
# https://github.com/rengwu/quinecms/blob/engine-separation/docs/wiki/features/media.md
