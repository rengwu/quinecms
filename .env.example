# Required to build the encrypted admin. Set these as build secrets on your host.
# pnpm dev always uses admin@example.com / asdf1234 instead.
# Email is trimmed and case-insensitive. Password is used exactly as entered.
# Use a long, unique password in production; email is not a second factor.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
PUBLIC_GIT_PROVIDER=github
# GitHub owner or GitLab namespace (including any subgroups).
PUBLIC_GIT_NAMESPACE=
PUBLIC_GIT_REPO=
PUBLIC_DRAFT_BRANCH=draft
PUBLIC_PUBLISH_BRANCH=main
PUBLIC_GITLAB_URL=https://gitlab.com
# PUBLIC_GITHUB_OWNER / PUBLIC_GITHUB_REPO remain fallback defaults for GitHub.
PUBLIC_R2_ACCOUNT_ID=
PUBLIC_R2_BUCKET=
PUBLIC_R2_PUBLIC_URL=
# Git provider and R2 write credentials are entered in the editor, never built in.
