{
  "name": "quinecms",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "check": "vitest run tests/local-authoring.test.ts tests/block-generation.test.ts",
    "wiki:check": "node docs/wiki/_build.mjs --check",
    "format": "prettier --write src scripts bin tests *.mjs *.ts *.json",
    "verify": "pnpm test && pnpm wiki:check"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/vue": "7.0.3",
    "@aws-sdk/client-s3": "3.1146.0",
    "@cloudflare/kumo": "2.14.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@octokit/rest": "22.0.1",
    "@phosphor-icons/react": "2.1.10",
    "astro": "7.3.5",
    "hash-wasm": "4.12.0",
    "lexical": "0.52.0",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "svelte": "5.57.1",
    "vue": "3.5.43",
    "@astrojs/check": "0.9.10",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-vue": "6.0.9",
    "postcss": "8.5.29",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "vitest": "5.0.3"
  },
  "bin": {
    "quinecms": "bin/quinecms.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "src/admin",
    "src/core",
    "src/editor",
    "src/integrations",
    "src/layouts",
    "src/pages",
    "astro.config.mjs",
    "src/env.d.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./core/types": "./src/core/types.ts",
    "./core/layout-contract": "./src/core/layout-contract.ts",
    "./core/content": "./src/core/content.ts",
    "./core/lists": "./src/core/lists.ts",
    "./core/bindings": "./src/core/bindings.ts",
    "./core/site-style": "./src/core/site-style.ts",
    "./core/layouts": "./src/core/layouts.ts",
    "./core/markdown": "./src/core/markdown.ts",
    "./editor/Fields": "./src/editor/Fields.tsx",
    "./editor/PanelSection": "./src/editor/PanelSection.tsx",
    "./editor/widgets": "./src/editor/widgets.ts",
    "./editor/SiteDesign": "./src/editor/SiteDesign.tsx",
    "./core/routes": "./src/core/routes.ts",
    "./editor/PanelNavigation": "./src/editor/PanelNavigation.tsx"
  }
}
